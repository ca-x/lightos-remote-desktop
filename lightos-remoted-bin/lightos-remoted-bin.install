#!/usr/bin/env bash
pre_upgrade() {
    /usr/lib/lightos-remoted/bootstrap --snapshot || return 1
}
post_install() {
    /usr/lib/lightos-remoted/bootstrap || return 1
}
post_upgrade() {
    /usr/lib/lightos-remoted/bootstrap || return 1
}
pre_remove() {
    # Preserve mapped owner/transport binaries and GUI processes until they exit.
    # Keep a payload snapshot and configuration for deliberate cleanup.
    /usr/lib/lightos-remoted/bootstrap --remove || return 1
}
