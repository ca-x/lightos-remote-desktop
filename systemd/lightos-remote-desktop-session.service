[Unit]
Description=LightOS Persistent Desktop Session

[Service]
Type=simple
User=@USER@
SupplementaryGroups=video render
EnvironmentFile=/etc/lightos/remote-desktop.env
EnvironmentFile=-/etc/lightos/remote-desktop-native.env
Environment=XDG_RUNTIME_DIR=/run/lrd-session
RuntimeDirectory=lrd-session
RuntimeDirectoryMode=0700
ExecStart=/usr/local/lib/lightos-remote-desktop/current/lightos-remote-desktop desktop-session --runtime-dir /run/lrd-session
KillMode=control-group
TimeoutStartSec=45
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
